participant "<<model>>\n:Interview" as modelInterview
database "<<MongoDB>>\n:companies" as dbCompanies
database "<<MongoDB>>\n:interviews" as dbInterviews

client -> server ++ : req.delete('/api/v1/companies/:id')\nAuthorization: Bearer <token>
server -> routerCompanies ++ : app.use('/api/v1/companies', companies)
routerCompanies -> mwAuth ++ : protect(), authorize('admin')
alt not logged in / not admin
  mwAuth --> client : 401 / 403
else
  mwAuth --> routerCompanies -- : next()
  routerCompanies -> ctrlCompanies ++ : deleteCompany()
  ctrlCompanies -> modelCompany ++ : findById(req.params.id)
  modelCompany -> dbCompanies ++ : CompanySchema
  dbCompanies --> modelCompany -- : company
  modelCompany --> ctrlCompanies -- : company
  alt company not found
    ctrlCompanies --> client : 404 {message: "Company not found with id of ..."}
  else
    ctrlCompanies -> modelInterview ++ : deleteMany({company: id})
    modelInterview -> dbInterviews ++ : InterviewSchema
    dbInterviews --> modelInterview -- : deleted
    modelInterview --> ctrlCompanies --
    ctrlCompanies -> modelCompany ++ : deleteOne({_id: id})
    modelCompany -> dbCompanies ++ : CompanySchema
    dbCompanies --> modelCompany -- : deleted
    modelCompany --> ctrlCompanies --
    ctrlCompanies --> client -- : 200 {success, data: {}}
  end
end
@enduml

