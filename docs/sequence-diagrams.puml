@startuml seq-05-get-companies
title Get Companies with Search (GET /api/v1/companies?name=&industry=&address=&radiusKm=)
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:companies" as routerCompanies
participant "<<middleware>>\n:auth" as mwAuth
participant "<<controllers>>\n:companies" as ctrlCompanies
participant "<<service>>\n:geocoding" as svcGeo
participant "<<external API>>\n:OpenCage" as openCage
participant "<<model>>\n:Company" as modelCompany
database "<<MongoDB>>\n:companies" as dbCompanies

client -> server ++ : req.get('/api/v1/companies?...')\nAuthorization: Bearer <token>
server -> routerCompanies ++ : app.use('/api/v1/companies', companies)
routerCompanies -> mwAuth ++ : protect()
alt no token / invalid token
  mwAuth --> client : 401 {msg: "Not authorized to access this route"}
else
  mwAuth --> routerCompanies -- : next() (req.user set)
  routerCompanies -> ctrlCompanies ++ : getCompanies()
  ctrlCompanies -> ctrlCompanies : buildCompanyFilter(req.query)\nname -> $regex, industry -> $in
  opt address in query
    alt address < 2 chars / lat or lng also given / radiusKm missing or not positive
      ctrlCompanies --> client : 400 {message: error}
    else
      ctrlCompanies -> svcGeo ++ : geocode(address)
      svcGeo -> openCage ++ : GET /geocode/v1/json?q=address&limit=5
      openCage --> svcGeo -- : results
      alt API key missing / API error / timeout / invalid response
        svcGeo --> ctrlCompanies : GeocodingError (502 / 503 / 504)
        ctrlCompanies --> client : 502 / 503 / 504 {message}
      else
        svcGeo --> ctrlCompanies -- : [{label, latitude, longitude}]
        alt 0 or more than 1 match
          ctrlCompanies --> client : 422 {message: "...please provide a more specific address"}
        else exactly 1 match
          ctrlCompanies -> ctrlCompanies : lat, lng = match.latitude, match.longitude
        end
      end
    end
  end
  ctrlCompanies -> ctrlCompanies : lat/lng/radiusKm -> $geoWithin $centerSphere
  alt invalid query (bad industry / incomplete or invalid lat, lng, radiusKm)
    ctrlCompanies --> client : 400 {message: error}
  else
    ctrlCompanies -> modelCompany ++ : countDocuments(filter)
    modelCompany -> dbCompanies ++ : CompanySchema
    dbCompanies --> modelCompany -- : total
    modelCompany --> ctrlCompanies -- : total
    ctrlCompanies -> modelCompany ++ : find(filter).populate('interviews')\n.select().sort().skip().limit()
    modelCompany -> dbCompanies ++ : CompanySchema
    dbCompanies --> modelCompany -- : companies
    modelCompany --> ctrlCompanies -- : companies
    ctrlCompanies -> ctrlCompanies : build pagination {next, prev}
    ctrlCompanies --> client -- : 200 {success, count, total, pagination, data}
  end
end
@enduml

