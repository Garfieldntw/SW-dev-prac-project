@startuml seq-10-get-interviews
title Get Interviews (GET /api/v1/interviews  or  /api/v1/companies/:companyId/interviews)
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:interviews" as routerInterviews
participant "<<middleware>>\n:auth" as mwAuth
participant "<<controllers>>\n:interviews" as ctrlInterviews
participant "<<model>>\n:Interview" as modelInterview
database "<<MongoDB>>\n:interviews" as dbInterviews

client -> server ++ : req.get('/api/v1/interviews')\nAuthorization: Bearer <token>
server -> routerInterviews ++ : app.use('/api/v1/interviews', interviews)
routerInterviews -> mwAuth ++ : protect()
alt no token / invalid token
  mwAuth --> client : 401
else
  mwAuth --> routerInterviews -- : next()
  routerInterviews -> ctrlInterviews ++ : getInterviews()
  alt req.user.role != 'admin'
    ctrlInterviews -> modelInterview ++ : find({user: req.user.id})\n.populate('company', 'name description tel')
  else admin with companyId
    ctrlInterviews -> modelInterview : find({company: companyId})\n.populate('company', 'name description tel')
  else admin
    ctrlInterviews -> modelInterview : find()\n.populate('company', 'name description tel')
  end
  modelInterview -> dbInterviews ++ : InterviewSchema
  dbInterviews --> modelInterview -- : interviews
  modelInterview --> ctrlInterviews -- : interviews
  ctrlInterviews --> client -- : 200 {success, count, data: interviews}
end
@enduml

