@startuml seq-12-add-interview
title Add Interview (POST /api/v1/companies/:companyId/interviews) — user, admin
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:companies" as routerCompanies
participant "<<router>>\n:interviews" as routerInterviews
participant "<<middleware>>\n:auth" as mwAuth
participant "<<controllers>>\n:interviews" as ctrlInterviews
participant "<<model>>\n:Interview" as modelInterview
participant "<<model>>\n:Company" as modelCompany
database "<<MongoDB>>\n:interviews" as dbInterviews
database "<<MongoDB>>\n:companies" as dbCompanies

client -> server ++ : req.post('/api/v1/companies/:companyId/interviews')\nAuthorization: Bearer <token>
server -> routerCompanies ++ : app.use('/api/v1/companies', companies)
routerCompanies -> routerInterviews ++ : router.use('/:companyId/interviews', interviewRouter)
routerInterviews -> mwAuth ++ : protect(), authorize('admin', 'user')
alt not logged in / role not allowed
  mwAuth --> client : 401 / 403
else
  mwAuth --> routerInterviews -- : next()
  routerInterviews -> ctrlInterviews ++ : addInterview()
  ctrlInterviews -> ctrlInterviews : req.body.user = req.user.id\nparseInterviewDate(req.body.interviewDate)
  alt invalid date or not between May 10-13, 2022
    ctrlInterviews --> client : 400 {message: "Interview date must be between May 10th and 13th, 2022"}
  else
    ctrlInterviews -> modelInterview ++ : find({user: req.user.id})
    modelInterview -> dbInterviews ++ : InterviewSchema
    dbInterviews --> modelInterview -- : existing interviews
    modelInterview --> ctrlInterviews -- : existing interviews
    alt already has 3 interviews and not admin
      ctrlInterviews --> client : 400 {message: "... has already booked 3 interviews"}
    else
      ctrlInterviews -> modelCompany ++ : findById(companyId)
      modelCompany -> dbCompanies ++ : CompanySchema
      dbCompanies --> modelCompany -- : company
      modelCompany --> ctrlInterviews -- : company
      alt company not found
        ctrlInterviews --> client : 404 {message: "No company with the id of ..."}
      else
        ctrlInterviews -> modelInterview ++ : create(req.body)
        modelInterview -> dbInterviews ++ : InterviewSchema
        dbInterviews --> modelInterview -- : interview
        modelInterview --> ctrlInterviews -- : interview
        ctrlInterviews --> client -- : 201 {success, data: interview}
      end
    end
  end
end
@enduml

@startuml seq-13-update-interview
title Update Interview (PUT /api/v1/interviews/:id) — owner or admin
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:interviews" as routerInterviews
participant "<<middleware>>\n:auth" as mwAuth
participant "<<controllers>>\n:interviews" as ctrlInterviews
participant "<<model>>\n:Interview" as modelInterview
database "<<MongoDB>>\n:interviews" as dbInterviews

client -> server ++ : req.put('/api/v1/interviews/:id')\nAuthorization: Bearer <token>
server -> routerInterviews ++ : app.use('/api/v1/interviews', interviews)
routerInterviews -> mwAuth ++ : protect(), authorize('admin', 'user')
alt not logged in / role not allowed
  mwAuth --> client : 401 / 403
else
  mwAuth --> routerInterviews -- : next()
  routerInterviews -> ctrlInterviews ++ : updateInterview()
  ctrlInterviews -> modelInterview ++ : findById(id)
  modelInterview -> dbInterviews ++ : InterviewSchema
  dbInterviews --> modelInterview -- : interview
  modelInterview --> ctrlInterviews -- : interview
  alt interview not found
    ctrlInterviews --> client : 404 {message: "No interview with the id of ..."}
  else not owner and not admin
    ctrlInterviews --> client : 401 {message: "User ... is not authorized to update this interview"}
  else
    opt interviewDate in body
      ctrlInterviews -> ctrlInterviews : parseInterviewDate(interviewDate)
      alt invalid date or not between May 10-13, 2022
        ctrlInterviews --> client : 400 {message: error}
      end
    end
    ctrlInterviews -> modelInterview ++ : findByIdAndUpdate(id, req.body,\n{new: true, runValidators: true})
    modelInterview -> dbInterviews ++ : InterviewSchema
    dbInterviews --> modelInterview -- : interview
    modelInterview --> ctrlInterviews -- : interview
    ctrlInterviews --> client -- : 200 {success, data: interview}
  end
end
@enduml

