@startuml seq-01-register
title Register (POST /api/v1/auth/register)
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as ctrlAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as dbUsers

client -> server ++ : req.post('/api/v1/auth/register')
server -> routerAuth ++ : app.use('/api/v1/auth', auth)
routerAuth -> ctrlAuth ++ : register()
ctrlAuth -> modelUser ++ : create({name, telephone, email, password, role})
modelUser -> modelUser : pre('save'): bcrypt.hash(password)
modelUser -> dbUsers ++ : UserSchema
alt validation error / duplicate email
  dbUsers --> modelUser : error
  modelUser --> ctrlAuth : error
  ctrlAuth --> client : 400 {success: false}
else success
  dbUsers --> modelUser -- : user
  modelUser --> ctrlAuth -- : user
  ctrlAuth -> modelUser ++ : user.getSignedJwtToken()
  modelUser --> ctrlAuth -- : token
  ctrlAuth --> client -- : 201 cookie(token) + {success, _id, name, email, token}
end
@enduml

@startuml seq-02-login
title Login (POST /api/v1/auth/login)
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<controllers>>\n:auth" as ctrlAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as dbUsers

client -> server ++ : req.post('/api/v1/auth/login')
server -> routerAuth ++ : app.use('/api/v1/auth', auth)
routerAuth -> ctrlAuth ++ : login()
alt email or password missing
  ctrlAuth --> client : 400 {msg: "Please provide an email and password"}
else
  ctrlAuth -> modelUser ++ : findOne({email}).select('+password')
  modelUser -> dbUsers ++ : UserSchema
  dbUsers --> modelUser -- : user
  modelUser --> ctrlAuth -- : user
  alt user not found
    ctrlAuth --> client : 401 {msg: "Invalid credentials"}
  else
    ctrlAuth -> modelUser ++ : user.matchPassword(password)
    modelUser --> ctrlAuth -- : isMatch (bcrypt.compare)
    alt password does not match
      ctrlAuth --> client : 401 {msg: "Invalid credentials"}
    else
      ctrlAuth -> modelUser ++ : user.getSignedJwtToken()
      modelUser --> ctrlAuth -- : token
      ctrlAuth --> client -- : 200 cookie(token) + {success, _id, name, email, token}
    end
  end
end
@enduml

@startuml seq-03-get-me
title Get Current User (GET /api/v1/auth/me)
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as routerAuth
participant "<<middleware>>\n:auth" as mwAuth
participant "<<controllers>>\n:auth" as ctrlAuth
participant "<<model>>\n:User" as modelUser
database "<<MongoDB>>\n:users" as dbUsers

client -> server ++ : req.get('/api/v1/auth/me')\nAuthorization: Bearer <token>
server -> routerAuth ++ : app.use('/api/v1/auth', auth)
routerAuth -> mwAuth ++ : protect()
mwAuth -> mwAuth : jwt.verify(token)
alt no token / invalid token
  mwAuth --> client : 401 {msg: "Not authorized to access this route"}
else
  mwAuth -> modelUser ++ : findById(decoded.id)
  modelUser -> dbUsers ++ : UserSchema
  dbUsers --> modelUser -- : user
  modelUser --> mwAuth -- : req.user
  mwAuth --> routerAuth -- : next()
  routerAuth -> ctrlAuth ++ : getMe()
  ctrlAuth -> modelUser ++ : findById(req.user.id)
  modelUser -> dbUsers ++ : UserSchema
  dbUsers --> modelUser -- : user
  modelUser --> ctrlAuth -- : user
  ctrlAuth --> client -- : 200 {success, data: user}
end
@enduml

