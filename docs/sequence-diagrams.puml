@startuml seq-07-create-company
title Create Company (POST /api/v1/companies) — admin only
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:companies" as routerCompanies
participant "<<middleware>>\n:auth" as mwAuth
participant "<<controllers>>\n:companies" as ctrlCompanies
participant "<<service>>\n:geocoding" as svcGeo
participant "<<external API>>\n:OpenCage" as openCage
participant "<<model>>\n:Company" as modelCompany
database "<<MongoDB>>\n:companies" as dbCompanies

client -> server ++ : req.post('/api/v1/companies')\nAuthorization: Bearer <token>
server -> routerCompanies ++ : app.use('/api/v1/companies', companies)
routerCompanies -> mwAuth ++ : protect()
mwAuth -> mwAuth : authorize('admin')
alt not logged in
  mwAuth --> client : 401 {msg: "Not authorized to access this route"}
else role is not admin
  mwAuth --> client : 403 {msg: "User role ... is not authorized"}
else
  mwAuth --> routerCompanies -- : next()
  routerCompanies -> ctrlCompanies ++ : createCompany()
  ctrlCompanies -> modelCompany ++ : new Company(companyInput(req.body))
  modelCompany --> ctrlCompanies -- : company
  ctrlCompanies -> modelCompany ++ : company.validate()
  modelCompany --> ctrlCompanies -- : ok / ValidationError
  alt ValidationError (missing field / invalid industry)
    ctrlCompanies --> client : 400 {message: "Invalid or duplicate company data"}
  else
    ctrlCompanies -> svcGeo ++ : geocodeAddress(company.address)
    svcGeo -> openCage ++ : GET /geocode/v1/json?q=address
    openCage --> svcGeo -- : results
    alt API unavailable / timeout / invalid response
      svcGeo --> ctrlCompanies : GeocodingError (502 / 503 / 504)
      ctrlCompanies --> client : 502 / 503 / 504 {message}
    else 0 or more than 1 match
      svcGeo --> ctrlCompanies : GeocodingError (422)
      ctrlCompanies --> client : 422 {message: "...more specific company address"}
    else exactly 1 match
      svcGeo --> ctrlCompanies -- : {type: "Point", coordinates: [lng, lat], formattedAddress}
      ctrlCompanies -> modelCompany ++ : company.location = location\ncompany.save()
      modelCompany -> dbCompanies ++ : CompanySchema
      dbCompanies --> modelCompany -- : company
      modelCompany --> ctrlCompanies -- : company
      alt duplicate company name
        ctrlCompanies --> client : 400 {message: "Invalid or duplicate company data"}
      else
        ctrlCompanies --> client -- : 201 {success, data: company}
      end
    end
  end
end
@enduml

@startuml seq-08-update-company
title Update Company (PUT /api/v1/companies/:id) — admin only
hide footbox
participant "client" as client
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:companies" as routerCompanies
participant "<<middleware>>\n:auth" as mwAuth
participant "<<controllers>>\n:companies" as ctrlCompanies
participant "<<service>>\n:geocoding" as svcGeo
participant "<<external API>>\n:OpenCage" as openCage
participant "<<model>>\n:Company" as modelCompany
database "<<MongoDB>>\n:companies" as dbCompanies

client -> server ++ : req.put('/api/v1/companies/:id')\nAuthorization: Bearer <token>
server -> routerCompanies ++ : app.use('/api/v1/companies', companies)
routerCompanies -> mwAuth ++ : protect(), authorize('admin')
alt not logged in / not admin
  mwAuth --> client : 401 / 403
else
  mwAuth --> routerCompanies -- : next()
  routerCompanies -> ctrlCompanies ++ : updateCompany()
  ctrlCompanies -> modelCompany ++ : findById(req.params.id)
  modelCompany -> dbCompanies ++ : CompanySchema
  dbCompanies --> modelCompany -- : company
  modelCompany --> ctrlCompanies -- : company
  alt company not found
    ctrlCompanies --> client : 400 {success: false}
  else
    ctrlCompanies -> modelCompany ++ : company.set(companyInput(req.body))\ncompany.validate()
    modelCompany --> ctrlCompanies -- : ok / ValidationError
    opt address changed OR (no location yet AND address sent)
      ctrlCompanies -> svcGeo ++ : geocodeAddress(company.address)
      svcGeo -> openCage ++ : GET /geocode/v1/json?q=address
      openCage --> svcGeo -- : results
      svcGeo --> ctrlCompanies -- : location / GeocodingError (422, 502-504)
    end
    ctrlCompanies -> modelCompany ++ : company.save()
    modelCompany -> dbCompanies ++ : CompanySchema
    dbCompanies --> modelCompany -- : company
    modelCompany --> ctrlCompanies -- : company
    ctrlCompanies --> client -- : 200 {success, data: company}
  end
end
@enduml

